{
  "name": "fifthpath-frontend",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "warn"
    }
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc -b && vite build --minify false --mode development",
    "build": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
